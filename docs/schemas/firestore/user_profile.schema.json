{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Nickname only; real names and emails are not stored here.",
  "properties": {
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "displayName": {
      "maxLength": 20,
      "minLength": 1,
      "title": "Displayname",
      "type": "string"
    },
    "grade": {
      "enum": [
        "j1",
        "j2",
        "j3",
        "h1",
        "h2",
        "h3"
      ],
      "title": "Grade",
      "type": "string"
    }
  },
  "required": [
    "displayName",
    "grade",
    "createdAt"
  ],
  "title": "UserProfile",
  "type": "object"
}
