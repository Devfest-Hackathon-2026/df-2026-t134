# Copy to .env and edit only when you need to override the defaults:
#   cp .env.example .env
# docker compose reads .env automatically. Never commit .env.

# Firebase project used by the emulators. "demo-" projects work fully offline.
FIREBASE_PROJECT_ID=demo-ailearn

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# API base URL that the Flutter web app calls from the browser.
API_BASE_URL=http://localhost:8000

# API App Check verification of the X-Firebase-AppCheck header: enforce | disabled.
# Local compose defaults to disabled (emulators have no App Check). The API refuses to start
# with APP_ENV=prod unless this is enforce, so Cloud Run must use enforce (the API default).
APP_CHECK_MODE=disabled
