rules_version = '2';

// Audio is generated by the server (TTS) and the content tools; clients only read it.
// Story scene pictures (images/) are generated by the content tools; clients only read them.
service firebase.storage {
  match /b/{bucket}/o {
    match /audio/{allPaths=**} {
      allow read: if request.auth != null;
    }
    match /images/{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}
