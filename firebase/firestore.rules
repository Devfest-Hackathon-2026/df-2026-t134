rules_version = '2';

// Data model: api/app/schemas/firestore.py (keep the two in sync).
// Only users/{uid} is written by clients. Everything else is written by the server
// (Admin SDK, which bypasses these rules) or by the content tools.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Nickname and school year only. Field names are camelCase like the API.
    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'grade', 'createdAt'])
        && data.keys().hasAll(['displayName', 'grade', 'createdAt'])
        && data.displayName is string
        && data.displayName.trim().size() >= 1
        && data.displayName.size() <= 20
        && data.grade in ['j1', 'j2', 'j3', 'h1', 'h2', 'h3']
        && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /progress/{uid} {
      allow get: if isOwner(uid);
    }

    match /attempts/{uid}/items/{attemptId} {
      allow read: if isOwner(uid);
    }

    // Published teaching material.
    match /units/{unitId} {
      allow read: if signedIn();
    }

    match /lessons/{lessonId} {
      allow read: if signedIn();
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn();
    }

    // answerKeys and exerciseDrafts have no rules on purpose: clients can never access them.
  }
}
